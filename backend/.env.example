# Copy this file, set real values, and export them in your shell before starting the backend.
# Spring Boot does NOT read .env files automatically — set these as shell environment variables
# or configure them in your IDE run configuration.
#
# Example (macOS/Linux):
#   export DB_URL=jdbc:mysql://localhost:3306/employee_management
#   export DB_USERNAME=root
#   export DB_PASSWORD=your_password
#   ./mvnw spring-boot:run
#
# Example (Windows PowerShell):
#   $env:DB_URL="jdbc:mysql://localhost:3306/employee_management"
#   $env:DB_USERNAME="root"
#   $env:DB_PASSWORD="your_password"
#   .\mvnw.cmd spring-boot:run

DB_URL=jdbc:mysql://localhost:3306/employee_management
DB_USERNAME=root
DB_PASSWORD=

# Controls Hibernate DDL mode: update | create | create-drop | validate | none
# The schema is owned by Flyway migrations now (see backend/src/main/resources/db/migration) -
# leave this as "validate" unless you have a specific reason to let Hibernate alter tables.
JPA_DDL_AUTO=validate

# The frontend origin allowed by CORS (must match your Vite dev server URL)
FRONTEND_URL=http://localhost:5173

# ── JWT ───────────────────────────────────────────────────────────────────────
# JWT_SECRET must be a long, random, secret string (32+ bytes) in any non-local
# environment. The value baked into application.properties as a fallback is a
# development-only placeholder - never reuse it in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Access token lifetime in milliseconds (default below: 15 minutes)
JWT_ACCESS_EXPIRATION=900000
# Refresh token lifetime in milliseconds (default below: 7 days)
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=employee-management

# ── Initial administrator bootstrap ─────────────────────────────────────────────
# Only used on startup, and only when no SYSTEM_ADMIN account exists yet. Leave
# both blank/unset to skip bootstrap (e.g. on every startup after the first).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Address of the Kafka broker. Default matches the docker-compose.yml setup.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic that employee activity events are published to.
EMPLOYEE_EVENTS_TOPIC=hr.employee.events
# Consumer group ID for the activity-log pipeline.
KAFKA_CONSUMER_GROUP=hr-employee-activity-consumer

# ── AI / HR Knowledge Assistant ────────────────────────────────────────────────
# Master switch. When false (default), the app still starts normally and AI
# endpoints return a structured 503 AI_DISABLED response.
AI_ENABLED=false
# Informational/validated only - see README "Provider abstraction note".
AI_PROVIDER=openai
# Chat completion API key. Required (with AI_ENABLED=true) for AI features to
# activate. NOT needed for embeddings - those run locally, see below.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=800
AI_TOP_K=5
AI_SIMILARITY_THRESHOLD=0.5
# Embeddings always run locally on a Hugging Face model (sentence-transformers/
# all-MiniLM-L6-v2, ONNX) regardless of the chat provider above - no API key
# needed. It's downloaded once on first use and cached at this path.
AI_EMBEDDING_CACHE_DIR=./data/onnx-model-cache
# Path where uploaded HR policy document originals are stored.
HR_DOCUMENT_STORAGE_PATH=./data/hr-policy-documents
HR_DOCUMENT_MAX_UPLOAD_BYTES=10485760
# Seeds a starter set of general workplace policies (code of conduct, attendance,
# leave, benefits, remote work, security, compensation) the first time the policy
# library is empty and AI is enabled, so the HR Assistant has something to answer
# from immediately. Set to false to manage policies manually from day one.
HR_DOCUMENT_SEED_DEFAULTS=true
