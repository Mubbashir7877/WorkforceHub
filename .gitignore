# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Backend ───────────────────────────────────────────────────────────────────
backend/target/
backend/*.log
backend/logs/
backend/data/

# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.log

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
**/.env
# Keep example files — they document required variables without containing secrets
!**/.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
